# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app, so only
# put client-safe values here (the publishable key is designed to be public;
# Row Level Security protects the data).

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# true = in-memory fake auth (no network). Any email/password works.
# Also used automatically when the Supabase values above are missing.
EXPO_PUBLIC_AUTH_MOCK=false

# FastAPI routing/ML backend (later phase)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Booking redirects (optional). Uber client ID for deep-link attribution; Ola XAPP
# token from the Ola developer platform (without it, Ola opens its store page).
EXPO_PUBLIC_UBER_CLIENT_ID=
EXPO_PUBLIC_OLA_XAPP_TOKEN=

# Google Maps SDK key for the native map on Android/iOS (read by app.config.ts at
# build time; not bundled into JS). Rebuild after changing it.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Same key for runtime calls to Routes API, Places API (New) and Geocoding API
# (src/services/config.ts). Bundled into the app: restrict it in Google Cloud.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Optional: SHA-1 of the Android signing cert, sent as X-Android-Cert when the key
# is restricted to Android apps (from `cd android && ./gradlew signingReport`).
EXPO_PUBLIC_ANDROID_CERT_SHA1=
