# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app, so only
# put client-safe values here (the publishable key is designed to be public;
# Row Level Security protects the data).

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# true = in-memory fake auth (no network). Any email/password works.
# Also used automatically when the Supabase values above are missing.
EXPO_PUBLIC_AUTH_MOCK=false

# FastAPI routing/ML backend (later phase)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Booking redirects (optional). Uber client ID for deep-link attribution; Ola XAPP
# token from the Ola developer platform (without it, Ola opens its store page).
EXPO_PUBLIC_UBER_CLIENT_ID=
EXPO_PUBLIC_OLA_XAPP_TOKEN=

# Google Maps SDK key for Android/iOS builds (read by app.config.ts at build time;
# not bundled into JS). Expo Go works without it.
GOOGLE_MAPS_API_KEY=
